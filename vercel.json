{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "{*.html,*.css,*.js,*.json,*.jpg,*.png,*.webp,public/**}"
    },
    "api/index.js": {
      "includeFiles": "{*.html,*.css,*.js,*.json,*.jpg,*.png,*.webp,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    }
  ]
}
