{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server.js,db.json,*.html,*.css,*.js,*.json,*.jpg,*.png,*.webp,*.ico,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/index.js"
    }
  ]
}
